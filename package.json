{
  "name": "webdeck",
  "version": "0.1.0",
  "private": true,
  "description": "Presenter for Claude Design HTML decks and PDF slides",
  "license": "UNLICENSED",
  "author": "William Goodall",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build -c vite.renderer.config.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "dist:mac": "pnpm build && electron-builder --mac --arm64 --publish never",
    "dist:win": "pnpm build && electron-builder --win --x64 --publish never",
    "start": "electron .",
    "smoke": "pnpm build && WEBDECK_SMOKE=out/smoke electron .",
    "dist:win:zip": "pnpm build && electron-builder --win zip --x64 --publish never",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.168.58",
    "@tanstack/router-plugin": "^1.168.40",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.17.0",
  "productName": "Webdeck"
}
