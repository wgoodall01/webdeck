{
  "extends": "./tsconfig.base.json",
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/preload/*.d.ts"],
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
